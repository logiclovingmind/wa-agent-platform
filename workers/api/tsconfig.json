{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Runtime types come from worker-configuration.d.ts, generated by `wrangler types`
    // from wrangler.jsonc. Rerun it after changing bindings.
    "types": ["./worker-configuration.d.ts"],
    "baseUrl": ".",
    "paths": {
      "@wa/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
